+/* wrk-monotonic: CLOCK_MONOTONIC en lugar de gettimeofday. Afecta a la
+ * latencia de cada petición, a la duración total y al muestreo de Req/Sec;
+ * los temporizadores de ae.c no cambian. */
 static uint64_t time_us() {
-    struct timeval t;
-    gettimeofday(&t, NULL);
-    return (t.tv_sec * 1000000) + t.tv_usec;
+    struct timespec t;
+    clock_gettime(CLOCK_MONOTONIC, &t);
+    return ((uint64_t) t.tv_sec * 1000000) + (uint64_t) t.tv_nsec / 1000;
 }
 
